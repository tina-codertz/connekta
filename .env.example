EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Mapbox public token (pk.*) — used at runtime for map tiles and web maps
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token
EXPO_PUBLIC_MAP_PROVIDER=mapbox

# Mapbox secret downloads token (sk.*) — only needed for native @rnmapbox/maps EAS builds
MAPBOX_DOWNLOADS_TOKEN=sk.your_mapbox_downloads_token
